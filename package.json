{
  "name": "opsmira",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,server -c green,cyan \"vite\" \"npm run dev --prefix server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev --prefix server",
    "setup": "npm ci && npm ci --prefix server",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && VITE_STATIC_SITE=1 SITE_BASE=${SITE_BASE:-/opsmira/} vite build --outDir dist-site",
    "start": "npm start --prefix server",
    "test": "npm test --prefix server",
    "check": "tsc --noEmit && npm test --prefix server",
    "preview": "vite preview"
  },
  "dependencies": {
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "description": "Opsmira: your server, in plain words. An AI operator console you can self-host.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevBash1/opsmira.git"
  },
  "engines": {
    "node": ">=20"
  }
}
