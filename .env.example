# Opsmira settings. Copy to server/.env (npm install) or pass as environment variables (Docker).

# Required. The model provider. Get a key at https://openrouter.ai/keys
# Add your own provider keys (BYOK) in OpenRouter to bill your own accounts.
OPENROUTER_API_KEY=

# Model used until you pick another in the console.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Any OpenAI-compatible endpoint works: OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sign-in for the console. The username defaults to "admin". Leave the password empty to have one
# generated on first start (printed once and saved to <data dir>/.admin-password).
# OPSMIRA_USERNAME=admin
# OPSMIRA_PASSWORD=

# Network. Keep HOST on 127.0.0.1 unless something in front of it adds HTTPS.
# HOST=127.0.0.1
# PORT=8787

# Where chats, memory, artifacts, the audit log and trusted hosts are kept.
# OPSMIRA_DATA_DIR=./server/data

# Behind a reverse proxy that terminates HTTPS (Caddy, nginx): trust X-Forwarded-Proto.
# OPSMIRA_TRUST_PROXY=1

# Also serve the marketing pages. Off by default: "/" opens the console.
# OPSMIRA_SITE=1

# Model calls one request may use before the agent writes a summary (default 30).
# OPSMIRA_MAX_ROUNDS=30
# Reply size cap per model call, in tokens (default 1024).
# OPSMIRA_MAX_TOKENS=1024
